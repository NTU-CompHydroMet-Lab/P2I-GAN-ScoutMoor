{
    "seed": 2024,
    "device": "cuda:0",
    "save_dir": "weights/p2igan_gan_v2",
    "experiment_name": "p2igan-gan-v2",
    "run_name": "debug-run-001",
    "description": "P2I-GAN baseline found artificat, try to fix, test without gan",
    "model": {
        "name": "p2igan",
        "in_channels": 1,
        "out_channels": 1
    },
    "data": {
        "train": {
            "data_root": "datasets/nimrod_h5/train",
            "w": 128,
            "h": 128,
            "sample_length": 16,
            "mask": {
                "type": "stis",
                "file": "datasets/masks/gauge_mask_1024_train.txt"
            }
        },
        "valid": {
            "data_root": "datasets/nimrod_h5/test",
            "shuffle": false
        },
        "test": {
            "data_root": "datasets/nimrod_h5/val",
            "w": 128,
            "h": 128,
            "mask": {
                "type": "stis",
                "file": "datasets/masks/gauge_mask_1024_train.txt"
            },
            "shuffle": false
        }
    },
    "loss": {
        "adversarial_weight": 0.1,
        "k1_weight": 0.0005,
        "gan_loss": "hinge",
        "use_gan": false
    },
    "train": {
        "optimizer": {
            "type": "Adam",
            "beta1": 0.0,
            "beta2": 0.99,
            "lr": 0.0001
        },
        "batch_size": 12,
        "num_workers": 4,
        "pin_memory": true,
        "persistent_workers": true,
        "prefetch_factor": 2,
        "log_step": 100,
        "iterations": 200000,
        "niter": 20000,
        "use_validation": true
    }
}
