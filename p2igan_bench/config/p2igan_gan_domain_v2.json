{
    "seed": 2024,
    "device": "cuda:0",
    "save_dir": "weights/domain-v2",
    "experiment_name": "p2igan-gan-domain",
    "run_name": "domain-v2",
    "log_to_wandb": true,
    "wandb_project": "p2igan-scoutmoor",
    "description": "P2I-GAN with robustness-only InputBlock (float32 kNN-IDW, matched grid, no AttentionBlock); NIMROD 2020-2023, Scout Moor domain. A/B against domain-v1.",
    "model": {
        "name": "p2igan_v2",
        "in_channels": 1,
        "out_channels": 1
    },
    "data": {
        "train": {
            "kind": "domain",
            "store": "datasets/nimrod_domain.zarr",
            "gauges": "datasets/gauges_in_domain.csv",
            "h": 128,
            "w": 128,
            "sample_length": 16,
            "start": "2020-01-01",
            "end": "2023-12-31",
            "stride": 1
        },
        "valid": {
            "kind": "domain",
            "store": "datasets/nimrod_domain.zarr",
            "gauges": "datasets/gauges_in_domain.csv",
            "h": 128,
            "w": 128,
            "sample_length": 16,
            "start": "2024-01-01",
            "end": "2024-12-31",
            "stride": 16
        },
        "test": {
            "kind": "domain",
            "store": "datasets/nimrod_domain.zarr",
            "gauges": "datasets/gauges_in_domain.csv",
            "h": 128,
            "w": 128,
            "sample_length": 16,
            "start": "2025-01-01",
            "end": "2025-12-31",
            "stride": 16
        }
    },
    "loss": {
        "adversarial_weight": 0.01,
        "k1_weight": 0.05,
        "use_pm": true,
        "pm_weight": 10.0,
        "gan_loss": "hinge",
        "use_gan": true
    },
    "train": {
        "optimizer": {
            "type": "Adam",
            "beta1": 0.0,
            "beta2": 0.99,
            "lr": 0.0001
        },
        "batch_size": 12,
        "num_workers": 4,
        "pin_memory": true,
        "persistent_workers": true,
        "prefetch_factor": 2,
        "log_step": 100,
        "iterations": 200000,
        "niter": 20000,
        "use_validation": true,
        "cudnn_benchmark": true,
        "compile": true
    }
}
